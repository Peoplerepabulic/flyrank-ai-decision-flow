# Set to 1 to point the Inngest client at the local Inngest dev server
# (the client also enables dev mode automatically when NODE_ENV != production).
INNGEST_DEV=1

# URL of the Inngest dev server the app sends events to.
# Default is http://localhost:8288. Change it if that port is already taken
# (e.g. by another project's dev server) and start yours with a matching
# --port flag (see README "Troubleshooting").
# INNGEST_BASE_URL=http://localhost:8288

# Optional: override the LLM HTTP endpoint used by every decision node.
# Default is the Pollinations keyless GET endpoint (no API key needed).
# LLM_BASE_URL=https://text.pollinations.ai
